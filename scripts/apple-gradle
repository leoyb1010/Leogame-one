#!/bin/zsh
set -euo pipefail

project_root=${0:A:h:h}
jdk_prefix=$(/opt/homebrew/bin/brew --prefix openjdk@17)
apple_cache_root="${APPLE_BUILD_ROOT:-$(getconf DARWIN_USER_CACHE_DIR)/escape-from-bukov-gradle}"
source_commit="$(git -C "$project_root" rev-parse HEAD)"
source_worktree="clean"
if [[ -n "$(git -C "$project_root" status --porcelain --untracked-files=all)" ]]; then
  source_worktree="dirty"
fi

export JAVA_HOME="$jdk_prefix/libexec/openjdk.jdk/Contents/Home"
export PATH="$jdk_prefix/bin:$PATH"
export APPLE_BUILD_ROOT="$apple_cache_root"
export BUKOV_SOURCE_COMMIT="$source_commit"
export BUKOV_SOURCE_WORKTREE="$source_worktree"

cd "$project_root"
exec ./gradlew "$@"
